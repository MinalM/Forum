  "private": true,
  "dependencies": {
    "@react-oauth/google": "^0.12.1",
    "@statsig/react-bindings": "^3.32.0",
    "axios": "^1.13.2",
    "date-fns": "^3.3.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "uuid": "^11.1.1",
