# API Configuration
REACT_APP_API_URL=https://aiml-forum.onrender.com

# Other client-side environment variables (if needed)
REACT_APP_GOOGLE_ANALYTICS_ID=your_ga_id_here

# Canonical site URL, used for the static og:url social preview tag
# (client/index.html). Set to the real production domain in the deploy
# environment (e.g. Netlify's env var UI) once it's known.
REACT_APP_SITE_URL=https://your-domain.example
