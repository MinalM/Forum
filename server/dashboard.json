{
    "title": "Forum App Observability",
    "widgets": [
        {
            "title": "HTTP Request Rate",
            "type": "graph",
            "query": "rate(http_server_requests_total[1m])",
            "width": "50%"
        },
        {
            "title": "HTTP Request Latency (P95)",
            "type": "graph",
            "query": "histogram_quantile(0.95, rate(http_server_duration_bucket[1m]))",
            "width": "50%"
        },
        {
            "title": "Posts Created",
            "type": "counter",
            "query": "sum(posts_created_total)",
            "width": "33%"
        },
        {
            "title": "Feature Flag Evaluations",
            "type": "counter",
            "query": "sum(feature_flag_evaluations_total)",
            "width": "33%"
        },
        {
            "title": "Error Rate",
            "type": "graph",
            "query": "rate(http_server_requests_total{status_code=~\"5..\"}[1m]) / rate(http_server_requests_total[1m])",
            "width": "33%"
        }
    ]
}