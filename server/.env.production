# MongoDB Atlas connection (required for production)
MONGO_URI=mongodb+srv://your_atlas_connection_string

# JWT configuration
JWT_SECRET=your_long_secure_jwt_secret
JWT_EXPIRE=24h
JWT_COOKIE_EXPIRE=1

# Server configuration
PORT=5000
NODE_ENV=production

# CORS configuration
CORS_ORIGIN=https://your-forum-app.netlify.app

# Optional: Session configuration
SESSION_SECRET=your_long_secure_session_secret

# Optional: Google OAuth (if implemented)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_CALLBACK_URL=https://your-render-app.onrender.com/auth/google/callback
