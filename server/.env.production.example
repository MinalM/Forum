# Production environment reference for server/.env.production (gitignored -
# see BACKLOG.md for why). Copy this file to server/.env.production and fill
# in real values locally if you need it, or set these directly in Render's
# environment variable UI - either way, never commit the filled-in file.

# MongoDB configuration (Atlas connection string in production)
MONGO_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/?retryWrites=true&w=majority

# JWT configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=24h
JWT_COOKIE_EXPIRE=1

# Server configuration
PORT=5000
NODE_ENV=production

# CORS configuration
CORS_ORIGIN=https://your-netlify-site.netlify.app

# Session configuration
SESSION_SECRET=your_session_secret_here

# OpenTelemetry configuration (for Render.com deployment)
# Set these in Render.com Environment Variables, NOT in this file
# See RENDER_OTEL_SETUP.md for detailed instructions
#
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp/v1/metrics
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64-encoded-credentials>
# OTEL_SERVICE_NAME=forum-server-production
