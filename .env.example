# MongoDB connection
MONGO_URI=mongodb://localhost:27017/ai_ml_forum

# JWT configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=24h
JWT_COOKIE_EXPIRE=1

# Server configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Atlas configuration (optional)
# MONGO_ATLAS_URI=mongodb+srv://your_atlas_connection_string