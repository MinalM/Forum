# MongoDB connection
MONGO_URI=mongodb://localhost:27017/ai_ml_forum

# JWT configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=24h
JWT_COOKIE_EXPIRE=1

# Server configuration
PORT=5000
NODE_ENV=development

# The server's own public base URL - used to build links (e.g. the weekly
# digest's unsubscribe link) that are composed outside of any HTTP request,
# such as scripts/send-weekly-digest.js, where there's no req to read the
# host from. Defaults to http://localhost:2000 (the dev server port) if unset.
SERVER_URL=http://localhost:2000

# Atlas configuration (optional)
# MONGO_ATLAS_URI=mongodb+srv://your_atlas_connection_string