{
  "name": "forum",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "prepare": "cd client && npm install",
    "install-all": "npm install && npm run prepare && cd server && npm install",
    "test": "jest --config server/jest.config.js --detectOpenHandles",
    "test:watch": "jest --config server/jest.config.js --watch",
    "test:coverage": "jest --config server/jest.config.js --coverage",
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "build:prod": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "start:prod": "NODE_ENV=production node server/server.js",
    "seed": "node server/seeder.js -i",
    "seed:delete": "node server/seeder.js -d",
    "prerender": "node scripts/prerender.js",
    "ci": "npm ci && cd client && npm ci && cd ../server && npm ci",
    "mongo:up": "docker-compose -f docker-compose.dev.yml up -d",
    "mongo:down": "docker-compose -f docker-compose.dev.yml down",
    "mongo:logs": "docker-compose -f docker-compose.dev.yml logs -f mongodb",
    "mongo:status": "docker-compose -f docker-compose.dev.yml ps",
    "mongo:container": "node scripts/switch-mongo.js container",
    "mongo:atlas": "node scripts/switch-mongo.js atlas"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/jest": "^30.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.4.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "form-data": "^4.0.1",
    "formidable": "^3.5.3",
    "brace-expansion": "^5.0.9",
    "minimatch": {
      "brace-expansion": "^2.0.2"
    },
    "js-yaml": "^3.15.1",
    "qs": "^6.16.0"
  }
}
