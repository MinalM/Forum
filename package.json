{
  "name": "forum",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "prepare": "cd client && npm install",
    "install-all": "npm install && npm run prepare",
    "test": "jest --config server/jest.config.js --detectOpenHandles",
    "test:watch": "jest --config server/jest.config.js --watch",
    "test:coverage": "jest --config server/jest.config.js --coverage",
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "build:prod": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "start:prod": "NODE_ENV=production node server/server.js",
    "seed": "node server/seeder.js -i",
    "seed:delete": "node server/seeder.js -d",
    "ci": "npm ci && cd client && npm ci && cd ../server && npm ci",
    "mongo:up": "docker-compose -f docker-compose.dev.yml up -d",
    "mongo:down": "docker-compose -f docker-compose.dev.yml down",
    "mongo:logs": "docker-compose -f docker-compose.dev.yml logs -f mongodb",
    "mongo:status": "docker-compose -f docker-compose.dev.yml ps",
    "mongo:container": "node scripts/switch-mongo.js container",
    "mongo:atlas": "node scripts/switch-mongo.js atlas"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.11.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.12",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "^3.1.9",
    "supertest": "^6.3.4"
  },
  "overrides": {
    "formidable": "^3.5.3",
    "form-data": "^4.0.1"
  }
}
