{
  "name": "forum",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "prepare": "cd client && npm install",
    "install-all": "npm install && npm run prepare",
    "test": "jest --config server/jest.config.js --detectOpenHandles",
    "test:watch": "jest --config server/jest.config.js --watch",
    "test:coverage": "jest --config server/jest.config.js --coverage",
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "seed": "node server/seeder.js -i",
    "seed:delete": "node server/seeder.js -d",
    "ci": "npm ci && cd client && npm ci",
    "mongo:container": "node scripts/switch-mongo.js container",
    "mongo:atlas": "node scripts/switch-mongo.js atlas"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.8.1",
    "bcryptjs": "^3.0.2",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.11.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.12",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "^3.1.9",
    "supertest": "^6.3.4"
  }
}
